rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Produtos digitais: leitura pública, escrita só para staff
    match /digital_products/{doc} {
      allow read: if true;
      allow write: if request.auth != null && isStaff();
    }
    
    // Pedidos: qualquer autenticado pode criar, staff pode ler/atualizar
    match /orders/{doc} {
      allow create: if true;
      allow read, update: if request.auth != null && isStaff();
    }
    
    // Time/colaboradores: só o owner pode gerenciar
    match /team/{email} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'djgugathebest@gmail.com';
    }
    
    // Mensagens do chat
    match /chat/{orderId}/messages/{msg} {
      allow read, create: if true;
      allow update, delete: if request.auth != null && isStaff();
    }
    
    function isStaff() {
      return request.auth.token.email == 'djgugathebest@gmail.com' ||
             exists(/databases/$(database)/documents/team/$(request.auth.token.email));
    }
  }
}
